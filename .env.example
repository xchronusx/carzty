##xchronusx
# ======================================================================
#  Carzty config. Copy this to .env and fill it in.
#  .env is gitignored. If you commit your token anyway, reset it in the
#  developer portal immediately and think about what you've done.
# ======================================================================

# REQUIRED - Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-token-here

# Timezone used to read "9am" for anyone who hasn't run /carzty timezone yet.
# IANA names only: America/Phoenix, America/New_York, Europe/London, Asia/Tokyo...
DEFAULT_TIMEZONE=UTC

# chill | salty | unhinged   (unhinged swears. you were warned)
DEFAULT_TONE=salty

# Where the sqlite database and logs live. Relative paths are from the repo root.
DATABASE_PATH=data/carzty.db
LOG_DIR=logs
LOG_LEVEL=INFO

# Lock the bot to specific Discord user IDs (comma separated). Empty = anyone can use it.
# Turn on Developer Mode in Discord, right click yourself, Copy User ID.
ALLOWED_USER_IDS=

# Guard rails
MAX_TASKS_PER_USER=50
# shortest allowed `every` and `nag`. keeps people from building a spam cannon.
MIN_INTERVAL=1m
# stop nagging after this many nags per reminder
MAX_NAGS=24

# Snooze buttons on every reminder (1 to 3 of them)
SNOOZE_OPTIONS=15m,1h

# How often the scheduler checks for due reminders, in seconds
TICK_SECONDS=10

# Finished one-time tasks get deleted after this many days. 0 = keep forever.
PURGE_DONE_AFTER_DAYS=30
##xchronusx
